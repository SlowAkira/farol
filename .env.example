# O banco local sai de `npm run db`, que fixa as portas do `prisma dev` em
# 51213 (servidor), 51214 (banco) e 51215 (shadow). Sem fixar, o prisma dev
# sorteia porta livre a cada reinicio e as URLs abaixo quebrariam toda vez.
# Usuario e senha do prisma dev sao fixos e o banco e sempre template1, entao
# `cp .env.example .env` ja sai funcionando.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

# Banco onde o `prisma migrate dev` replaya as migracoes antes de aplica-las.
# `npx prisma dev` sobe PGlite, que so tem o banco template1: sem isto o migrate
# usa o proprio banco de desenvolvimento como shadow e falha ao recriar os tipos.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

# Banco usado pelos testes de ingestao. Cada worker do Vitest cria, migra e
# derruba o proprio schema farol_test_<n> aqui. Se ausente, cai em DATABASE_URL —
# aceitavel com o banco local de `npm run db`, nunca com banco compartilhado.
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

# Protege POST/GET /api/cron/sync. Gere com `openssl rand -hex 32`.
# Na Vercel, basta definir a variavel no projeto: o Cron passa a mandar
# `Authorization: Bearer <CRON_SECRET>` sozinho na chamada agendada.
# Sem ela a rota responde 500 e nao sincroniza nada — nunca abre.
CRON_SECRET=

# mock | live
# Obrigatoria quando NODE_ENV=production: sem ela o painel subiria servindo dado
# inventado como se fosse da conta do anunciante. Fora de producao o padrao e mock.
DATA_PROVIDER=mock

# Probabilidade de o MockProvider falhar com erro transitorio, para exercitar o retry.
MOCK_PROVIDER_ERROR_RATE=0

# Ultimo dia da janela de 120 dias que o MockProvider serve; o inicio e 119 dias
# antes. Sem ela a ancora reancora sozinha em "ontem" (UTC) a cada chamada, entao
# "ultimos N dias" nunca fica vazio. Defina so para fixar uma data especifica
# (demos, capturas de tela). Data invalida derruba na inicializacao.
MOCK_PROVIDER_END_DATE=
