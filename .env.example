DATABASE_URL="postgresql://user:password@localhost:5432/farol?schema=public"

# Banco onde o `prisma migrate dev` replaya as migracoes antes de aplica-las.
# `npx prisma dev` sobe PGlite, que so tem o banco template1: sem isto o migrate
# usa o proprio banco de desenvolvimento como shadow e falha ao recriar os tipos.
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5433/farol?schema=public"

# Banco usado pelos testes de ingestao. Cada worker do Vitest cria, migra e
# derruba o proprio schema farol_test_<n> aqui. Se ausente, cai em DATABASE_URL —
# aceitavel com o banco local de `npx prisma dev`, nunca com banco compartilhado.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/farol"

# mock | live
# Obrigatoria quando NODE_ENV=production: sem ela o painel subiria servindo dado
# inventado como se fosse da conta do anunciante. Fora de producao o padrao e mock.
DATA_PROVIDER=mock

# Probabilidade de o MockProvider falhar com erro transitorio, para exercitar o retry.
MOCK_PROVIDER_ERROR_RATE=0

# Ultimo dia da janela de 120 dias que o MockProvider serve; o inicio e 119 dias
# antes. Sem ela a ancora fica em 2026-08-05, entao vale reancorar conforme o tempo
# passa, ou "ultimos 7 dias" aparece vazio. Data invalida derruba na inicializacao.
MOCK_PROVIDER_END_DATE=2026-08-05
