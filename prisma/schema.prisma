// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Sem `url` nem `directUrl` aqui de proposito: o Prisma 7 recusa os dois no
// schema (P1012, "no longer supported in schema files") e manda as URLs para o
// prisma.config.ts, que e onde a pooled e a direta se separam.
datasource db {
  provider = "postgresql"
}

enum Platform {
  META
  GOOGLE
}

enum AccountStatus {
  ACTIVE
  PAUSED
  DISCONNECTED
}

enum CampaignObjective {
  CONVERSIONS
  TRAFFIC
  AWARENESS
  LEADS
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  ARCHIVED
  DELETED
}

enum AlertMetric {
  CPA
  ROAS
  CTR
  CPM
  SPEND
  FREQUENCY
}

enum AlertComparison {
  PCT_CHANGE
  ABSOLUTE_THRESHOLD
}

enum AlertDirection {
  ABOVE
  BELOW
}

enum AlertScope {
  ACCOUNT
  CAMPAIGN
}

enum AlertStatus {
  OPEN
  RESOLVED
  MUTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  // Usuario fixo criado pelo prisma/seed.ts. auth.ts usa isto (via callback de
  // sessao) para bloquear mutacao sem precisar comparar e-mail em toda action.
  isDemo        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  adAccounts AdAccount[]
  alertRules AlertRule[]
  accounts   Account[]
  sessions   Session[]
}

// Modelos abaixo seguem o schema padrao do @auth/prisma-adapter (nomes e tipos
// de campo nao sao escolha nossa): mudar a forma quebra o adapter em silencio.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Sem uso em runtime enquanto a sessao for JWT (login demo exige isso, ja que
// Credentials provider nao roda com strategy "database"), mas o adapter exige
// o delegate para o Google poder linkar conta na troca futura de estrategia.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AdAccount {
  id         String        @id @default(cuid())
  userId     String
  externalId String
  platform   Platform
  name       String
  currency   String
  timezone   String
  status     AccountStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns  Campaign[]
  alertRules AlertRule[]

  @@unique([userId, platform, externalId])
}

model Campaign {
  id               String            @id @default(cuid())
  adAccountId      String
  externalId       String
  name             String
  objective        CampaignObjective
  status           CampaignStatus
  dailyBudgetCents Int?
  createdAt        DateTime          @default(now())

  adAccount AdAccount      @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  insights  DailyInsight[]
  alerts    Alert[]

  @@unique([adAccountId, externalId])
}

// Regra de alerta, avaliada por src/lib/alerts/engine.ts ao final de cada
// sincronizacao. `threshold` e sempre magnitude positiva na unidade que o mapa
// de src/lib/alerts/metrics.ts define para a metrica -- ler o numero sem saber
// a metrica e a comparacao e ambiguo, e aquele mapa e a unica fonte da verdade.
// Quem da sinal a magnitude e `direction`: em ABSOLUTE_THRESHOLD, ABOVE dispara
// com o valor acima do limiar; em PCT_CHANGE, ABOVE e "subiu mais que X%" e
// BELOW e "caiu mais que X%".
model AlertRule {
  id          String          @id @default(cuid())
  userId      String
  adAccountId String
  name        String
  metric      AlertMetric
  comparison  AlertComparison
  direction   AlertDirection
  // ACCOUNT avalia a conta inteira e abre um alerta so; CAMPAIGN avalia cada
  // campanha da conta em separado e abre um alerta por campanha infratora.
  scope       AlertScope
  threshold   Int
  windowDays  Int             @default(7)
  enabled     Boolean         @default(true)
  createdAt   DateTime        @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  alerts    Alert[]

  @@unique([userId, name])
  @@index([adAccountId, enabled])
}

// Disparo de uma regra. `fingerprint` e o hash de (ruleId, campaignId, direcao)
// e e o que impede a mesma condicao virar alerta novo a cada sincronizacao:
// enquanto existir um OPEN (ou MUTED) com o mesmo fingerprint, nao se abre
// outro. `context` guarda os numeros que motivaram o disparo -- periodo, valor,
// valor anterior e os totais das duas janelas -- para a /alerts poder explicar
// o alerta em portugues sem reconsultar o DailyInsight.
model Alert {
  id          String      @id @default(cuid())
  ruleId      String
  campaignId  String?
  triggeredAt DateTime    @default(now())
  fingerprint String
  status      AlertStatus @default(OPEN)
  context     Json
  resolvedAt  DateTime?

  rule     AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([fingerprint, status])
  @@index([ruleId, status])
}

model DailyInsight {
  id                   String   @id @default(cuid())
  campaignId           String
  date                 String
  impressions          Int
  clicks               Int
  spendCents           Int
  conversions          Int
  conversionValueCents Int
  reach                Int
  ingestedAt           DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
}
